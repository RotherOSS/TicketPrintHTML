    }

    .RTL .OverviewMedium input.Checkbox {
        left: auto;
        right: 0px;
    }

    .RTL .OverviewMedium div.Checkbox input {
        margin-left: 0px;
        margin-right: 8px;
    }

    .OverviewMedium div.Flag {
        top: 37px;
        left: 8px;
        position: absolute;
        width: 22px;
